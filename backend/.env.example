# PROVEX Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment: 'development', 'staging', 'production'
PROVEX_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database URL
# For local development with SQLite:
DATABASE_URL=sqlite:///./provex_dev.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/provex_db

# Security & JWT Tokens
# Generate a strong 256-bit random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ALGORITHM=HS256

# Token Lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Rate Limiting (requests per minute per IP for sensitive auth routes)
AUTH_RATE_LIMIT_PER_MINUTE=20

# CORS Allowed Origins (comma-separated, or * in dev)
CORS_ORIGINS=*

# GitHub OAuth App Configuration
# Register an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/github/callback

# Server-Side Token Encryption Key (Fernet 32-byte urlsafe base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=CHANGE_THIS_TO_FERNET_KEY_OR_LEAVE_EMPTY_FOR_DEV_EPHEMERAL
